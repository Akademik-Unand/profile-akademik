NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# MySQL di VM host (BUKAN di Docker). Sesuaikan host/user/pass.
# Contoh di Linux Docker: host.docker.internal atau IP gateway docker (sering 172.17.0.1)
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=profile_akademik
DB_USER=profile_akademik
DB_PASS=ganti-password-mysql

JWT_SECRET=ganti-dengan-secret-yang-panjang-dan-acak
JWT_EXPIRES_IN=7d
COOKIE_NAME=pa_token

# Origin HTTPS production (wajib https). Pisahkan dengan koma jika lebih dari satu.
FRONTEND_ORIGIN=https://nama-domain.unand.ac.id

SEED_ADMIN_PASSWORD=Admin123!

UPLOAD_DIR=/app/backend/uploads
# URL publik upload harus HTTPS
PUBLIC_UPLOAD_URL=https://nama-domain.unand.ac.id/uploads
MAX_UPLOAD_BYTES=10485760
